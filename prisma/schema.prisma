// benkyousagi データモデル
// 参照: docs/REQUIREMENTS.md 6章「データモデル概略」
// provider は開発・本番とも "sqlite" のまま。本番は無課金の Turso(libSQL, SQLite互換)を
// アダプタ経由で使う想定のため、schema側の変更は不要(接続先の切り替えは src/lib/db.ts と環境変数のみ)。

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum RibbonColor {
  PINK // くすみピンク
  LAVENDER
  MINT
  CREAM
}

enum TimerType {
  COUNTUP
  COUNTDOWN
  POMODORO
}

// REQUIREMENTS.md 3-3-1 節: セッションがどう終わったか
enum EndReason {
  COMPLETED // カウントダウン満了 / ポモドーロ全セット完了
  MANUAL // 手動での途中終了
  INACTIVITY_AUTO // 3時間無操作の確認に無応答で自動停止
  RECOVERED // アプリを閉じたまま等の異常終了を、次回起動時に救済確定
}

// REQUIREMENTS.md 3-7節: コインの増減理由
enum CoinReason {
  STUDY_SESSION // 実勉強時間1分につき+1
  COMPLETION_BONUS // 満了/ポモドーロ全セット完了時の+20
  MOOD_CHECKIN // きょうのきぶん回答時の+10
  PURCHASE // おみせでの消費
}

model User {
  id                String   @id @default(cuid())
  displayName       String   @unique
  pinHash           String
  failedPinAttempts Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())

  // REQUIREMENTS.md 3-7節: コイン残高。増減は必ずCoinTransactionと同一トランザクションで行う。
  coinBalance Int @default(0)

  rabbit        Rabbit?
  studySessions StudySession[]
  tags          Tag[]
  dailyAggregates DailyAggregate[]
  moodEntries   MoodEntry[]
  coinTransactions CoinTransaction[]
  ownedItems    OwnedItem[]
  loginEvents   LoginEvent[]
}

// REQUIREMENTS.md 3-4節: うさぎステータス仕様
model Rabbit {
  id                String      @id @default(cuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String      @default("おもち")
  ribbonColor       RibbonColor @default(CREAM)
  energy            Int         @default(60) // 0-100。lastSessionEndAt 時点の確定値（減衰は読み取り時に computeCurrentEnergy() で計算）
  lastSessionEndAt  DateTime?
  onboardedAt       DateTime? // nullの間は初回オンボーディング(命名・リボン色・世界観説明)を表示する

  // REQUIREMENTS.md 3-7節: 装備中アクセサリーの商品コード(未装備はnull)。
  // 所持アクセサリー(OwnedItem)に存在するコードのみ許可(アプリ側で検証)。
  equippedItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// REQUIREMENTS.md 3-2, 3-3節: 勉強セッション
model StudySession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  timerType TimerType
  startedAt DateTime
  endedAt   DateTime?

  // 3-3-1節: 無操作自動停止・異常終了救済のためのハートビート。
  // クライアントは「計測中」の間、一定間隔でこれを更新する（一時停止中は更新しない＝停止した時点の値で凍結）。
  // 次回起動時、endedAt が null かつ lastHeartbeatAt が古すぎるセッションを検知し、
  // accumulatedSeconds を実勉強時間として RECOVERED 確定する。
  lastHeartbeatAt    DateTime @default(now())
  accumulatedSeconds Int      @default(0)

  // 実勉強時間（休憩・スキップ分・無操作猶予分を除いた確定時間）。
  // セッション進行中は null、確定時に秒数を書き込む。
  durationSeconds Int?
  endReason       EndReason?

  // ポモドーロのみ使用
  pomodoroSetsCompleted Int @default(0)
  breaksSkipped         Int @default(0)

  // 開始時の設定(目標時間・ポモドーロプリセット)を確定させておく(タイマー種別ごとにCOUNTDOWN/POMODOROのみ使用)。
  // それまでは開始画面が組み立てたURLクエリだけが値の出どころで、ホーム経由で離脱後に
  // /timer の再開バナーからこのURL無しで再訪すると値を復元できずリダイレクトループしていた。
  targetSeconds             Int? // カウントダウンの目標秒数
  pomodoroWorkSeconds       Int?
  pomodoroShortBreakSeconds Int?
  pomodoroLongBreakSeconds  Int?
  pomodoroSetsUntilLong     Int?

  tags StudySessionTag[]

  createdAt DateTime @default(now())

  @@index([userId, startedAt])
}

// REQUIREMENTS.md 3-5, 3-6節: 科目タグ（ユーザーごとの自由登録）
model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  sessions StudySessionTag[]

  @@unique([userId, name])
}

model StudySessionTag {
  studySessionId String
  studySession   StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([studySessionId, tagId])
}

// 「きょうのきぶん」チェックイン(1日1回)。
// moodDate は日本時間(Asia/Tokyo)基準の "YYYY-MM-DD" 文字列(src/lib/jst.ts で生成)。
// サーバーのタイムゾーン(Vercel本番はUTC)に依存させないため、DateTimeではなく正規化済み文字列で持つ。
// リセットはJSTの深夜0時 = moodDate が変わることで自然に実現される。
model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodDate  String // JST基準 "YYYY-MM-DD"
  level     Int // 1-4 (src/lib/mood.ts の MoodLevel)
  createdAt DateTime @default(now())

  @@unique([userId, moodDate])
}

// REQUIREMENTS.md 6章: 比較ウィジェット・可視化画面の表示高速化用の事前集計
model DailyAggregate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime // 日付のみ使用（00:00に正規化）
  totalSeconds   Int      @default(0)
  sessionCount   Int      @default(0)

  @@unique([userId, date])
}

// コインの増減履歴(REQUIREMENTS.md 3-7節)。残高(User.coinBalance)だけでは増減の由来が
// 消えるため、履歴表示・不正調査用に持つ。refIdで由来(StudySession.id・moodDate等)を残し、
// (userId, reason, refId)の一意制約でStudySession/MoodEntry起因の二重加算を防ぐ
// (購入等refIdを使わない行はnullでよく、SQLiteはnull同士を区別するため一意制約に抵触しない)。
model CoinTransaction {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // 正=獲得、負=消費
  reason    CoinReason
  refId     String?
  createdAt DateTime   @default(now())

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
}

// 所持アクセサリー(REQUIREMENTS.md 3-7節)。買い切り品の所有記録。
// にんじんは消耗品(所有物を持たない)のため対象外、CoinTransaction(PURCHASE)にのみ記録される。
model OwnedItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String // 商品コード。価格・名前・カテゴリはDBに持たず src/lib/shop.ts の定数で管理する
  purchasedAt DateTime @default(now())

  @@unique([userId, itemId])
}

// ログイン履歴(2026-07-16追加)。「比較詳細画面」でお互いの最近のログインが見えるようにするための記録。
// セッションは30日間有効(src/lib/session.ts)なので、これはアプリを開いた全アクセスではなく
// PINでの明示的なログイン成功のみを記録する(loginAction参照)。
model LoginEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedInAt DateTime @default(now())

  @@index([userId, loggedInAt])
}
